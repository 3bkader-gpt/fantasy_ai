GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

FPL_EMAIL=your_fpl_email@example.com
FPL_PASSWORD=your_fpl_password
FPL_COOKIE=your_pl_profile_cookie_value
FPL_TEAM_ID=123456

# True = Simulation only, False = Live execution
DRY_RUN=True
MAX_ALLOWED_HITS=1
HORIZON_WEEKS=3
HORIZON_DECAY=0.85

# Optional Telegram Alerts (Inspired by FPL-Auto & fantasy-football-bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
